DATABASE_URL="postgresql://user:password@localhost:5432/gest224?schema=public"

# Générer avec : openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Chemin vers un exécutable Chromium, requis pour la génération PDF
# (Puppeteer). En production, l'image Docker le définit automatiquement
# (/usr/bin/chromium) — ne renseigner que pour le développement local.
CHROMIUM_EXECUTABLE_PATH=""

# URL publique de l'application, utilisée pour construire les liens envoyés
# par email (réinitialisation de mot de passe). Sans elle, retombe sur
# http://localhost:3000 — à définir en production avec le vrai domaine.
APP_URL="http://localhost:3000"

# Optionnelles : sans RESEND_API_KEY, les emails (réinitialisation de mot de
# passe) sont simplement journalisés dans les logs serveur au lieu d'être
# envoyés — pratique en développement, insuffisant pour une vraie mise en
# production (voir lib/email.ts).
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""

# Paiement des abonnements (Stripe). Sans STRIPE_SECRET_KEY, le passage à un
# plan payant échoue proprement (message d'erreur) plutôt que de planter
# l'app — le plan gratuit et tout le reste fonctionnent normalement.
# - STRIPE_SECRET_KEY : clé secrète (sk_test_... en test, sk_live_... en prod)
# - STRIPE_WEBHOOK_SECRET : signature du endpoint webhook (whsec_...), donnée
#   par Stripe à la création du webhook (dashboard ou API)
# - STRIPE_PRICE_STARTER / STRIPE_PRICE_PRO : identifiants des Price Stripe
#   (price_...) correspondant aux plans payants de lib/plans.ts
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_PRO=""
