DATABASE_URL="postgresql://user:password@localhost:5432/gest224?schema=public"

# Générer avec : openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string"

# Chemin vers un exécutable Chromium, requis pour la génération PDF
# (Puppeteer). En production, l'image Docker le définit automatiquement
# (/usr/bin/chromium) — ne renseigner que pour le développement local.
CHROMIUM_EXECUTABLE_PATH=""
